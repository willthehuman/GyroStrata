+    require(fs.verify_bad==0,"verify found a slot whose source bytes were rewritten under it");
+    src.set_foresight_swap(nullptr);
+    std::cout<<"foresight rebalance: dropped "<<fs.dropped<<", "<<fs.report()<<": PASS\n";
+    src.close();
+}
