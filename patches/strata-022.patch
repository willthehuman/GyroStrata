+    require(src.rebalance_ram(gpu,heat,1)==1,"one hot file blob must replace expert 0's RAM place");
+    require(std::memcmp(src.resident_blob(0,4),truth[4].data(),bytes)==0,"promoted bytes corrupted");
+    unsigned long long ptr=0;
+    const bool served=fs.take(0,0,ptr);
